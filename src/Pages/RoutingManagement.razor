@page "/routing-management"
@page "/dynamic-fee-management"
@using Blazorise
@using Blazorise.Components
@using NodeGuard.Data.Models
@using NodeGuard.Helpers
@attribute [Authorize(Roles = "Superadmin,NodeManager")]

<div class="peers">
    <h3 class="custom-primary">Routing Management</h3>
    <p style="color:#7a7789;margin-top:-4px;">
        Pick a node, then turn dynamic fee management and automatic rebalancing on or off for every channel to a peer at once — no more going channel by channel.
    </p>

    @if (!Constants.ROUTING_ENGINE_ENABLED)
    {
        <div class="alert-global">
            <Icon Name="IconName.ExclamationTriangle" />
            The routing engine is globally OFF. Per-channel and per-node settings are saved, but no fees will move and no rebalance will start until ROUTING_ENGINE_ENABLED is set on the server.
        </div>
    }

    @if (_loading)
    {
        <div class="empty"><SpinKit Type="SpinKitType.Wave" Color="#6145F1" /> Loading peers…</div>
    }
    else
    {
        <!-- NODE SELECTOR -->
        <div class="searchbar">
            <Field class="grow" style="margin-bottom:0;">
                <FieldLabel>Node</FieldLabel>
                <Autocomplete TItem="Node"
                              TValue="int?"
                              Data="@_managedNodes"
                              TextField="@(item => item?.Name ?? "")"
                              ValueField="@(item => (int?)item?.Id)"
                              @bind-SelectedValue="@_selectedNodeId"
                              @bind-SelectedValue:after="OnNodeChanged"
                              Placeholder="Select a node"
                              FreeTyping="false"
                              MinLength="0"
                              Filter="AutocompleteFilter.Contains" />
            </Field>
        </div>

        @if (_managedNodes.Count == 0)
        {
            <div class="empty">You don't manage any nodes.</div>
        }
        else if (_selectedNode is null)
        {
            <div class="empty">Select a node to configure its channels.</div>
        }
        else
        {
            <!-- SUMMARY -->
            <div class="summary">
                <div class="panel kpi"><div class="label">Peers</div><div class="val">@_peers.Count</div></div>
                <div class="panel kpi"><div class="label">Channels</div><div class="val">@_nodeChannels.Count</div></div>
                <div class="panel kpi">
                    <div class="label">Dynamic-fee channels</div>
                    <div class="val">@_nodeChannels.Count(c => c.IsDynamicFeeEnabled) <span style="font-size:.7rem;color:#7a7789">/ @_nodeChannels.Count</span></div>
                </div>
                <div class="panel kpi">
                    <div class="label">Open recommendations</div>
                    <div class="val">@_recommendations.Count</div>
                </div>
                <div class="panel kpi">
                    <div class="label">Rebalance sources</div>
                    <div class="val">@_nodeChannels.Count(c => c.IsAutoRebalanceEnabled) <span style="font-size:.7rem;color:#7a7789">/ @_nodeChannels.Count</span></div>
                </div>
            </div>

            <!-- NODE GATES -->
            @* Both actuators are gated per node. They're independent: a node can move fees without ever
               rebalancing, and vice versa. *@
            <div class="panel" style="margin-bottom:16px">
                <div class="panel-title">
                    <h2>Routing engine gates — @_selectedNode.Name</h2>
                    <span class="hint">
                        @StringHelper.TruncateTail(_selectedNode.PubKey, 14)
                        @if (_selectedNode.RoutingEngineDryRun)
                        {
                            <span class="dry"> · dry-run</span>
                        }
                    </span>
                </div>

                <div class="gates">
                    @foreach (var flag in AllFlags)
                    {
                        <div class="gate-item">
                            <div class="who">
                                <b>@FlagName(flag)</b>
                                <span class="desc">@GateDescription(flag)</span>
                            </div>
                            <div class="toggle">
                                <Check TValue="bool"
                                       Checked="@GateOn(_selectedNode, flag)"
                                       Disabled="@_busy"
                                       CheckedChanged="@(value => ToggleNodeGate(flag, value))" />
                            </div>
                        </div>
                    }
                </div>

                @foreach (var flag in AllFlags.Where(f => !GateOn(_selectedNode, f)))
                {
                    <div class="gate-warn" style="margin-top:10px;">
                        <Icon Name="IconName.ExclamationTriangle" /> @GateOffWarning(flag)
                    </div>
                }

                @* Budget, in-flight cap and the profit gate are edited on the Nodes page; shown here read-only
                   because a node with no budget is silently skipped by the rebalancer. *@
                <div class="budget">
                    <div class="b-item">
                        <span class="k">Rebalance fee budget</span>
                        <span class="v">@(_selectedNode.RebalanceBudgetSats is > 0 ? $"{Sats(_selectedNode.RebalanceBudgetSats.Value)} sats" : "—")</span>
                    </div>
                    <div class="b-item">
                        <span class="k">Spent this period</span>
                        <span class="v">@(_rebalanceConsumedSats is { } spent ? $"{Sats(spent)} sats" : "—")</span>
                    </div>
                    <div class="b-item">
                        <span class="k">Budget refresh</span>
                        <span class="v">@BudgetRefreshText(_selectedNode)</span>
                    </div>
                    <div class="b-item">
                        <span class="k">In flight</span>
                        <span class="v">@(_rebalanceInFlight?.ToString() ?? "—") / @(_selectedNode.MaxRebalancesInFlight ?? Constants.ROUTING_ENGINE_REBALANCE_DEFAULT_MAX_IN_FLIGHT)</span>
                    </div>
                    <div class="b-item">
                        <span class="k">Max cost-to-earn</span>
                        <span class="v">@F(_selectedNode.MaxRebalanceCostToEarnRatio ?? Constants.ROUTING_ENGINE_REBALANCE_DEFAULT_COST_TO_EARN_RATIO)</span>
                    </div>
                </div>
                @if ((_selectedNode.RebalanceBudgetSats ?? 0) <= 0)
                {
                    <div class="gate-warn" style="margin-top:10px;">
                        <Icon Name="IconName.ExclamationTriangle" />
                        No rebalance fee budget configured for this node — the rebalancer skips it. Set one on the Nodes page.
                    </div>
                }
            </div>

            <!-- CHANNEL OPEN RECOMMENDATIONS -->
            @* Node-level only: the channel-open actuator has no per-channel opt-in, so it is not part
               of AllFlags (which also drives the per-channel toggles in the peers table below). *@
            <div class="panel" style="margin-bottom:16px">
                <div class="panel-title">
                    <h2>Channel open recommendations</h2>
                    <span class="hint">Peers turning payments away for lack of our outbound</span>
                </div>

                <div class="gates">
                    <div class="gate-item">
                        <div class="who">
                            <b>Auto channel open</b>
                            <span class="desc">Watch refused forwards and propose new capacity to the peers that keep running dry.</span>
                        </div>
                        <div class="toggle">
                            <Check TValue="bool"
                                   Checked="@_selectedNode.AutoChannelOpenEnabled"
                                   Disabled="@_busy"
                                   CheckedChanged="@(value => ToggleChannelOpenGate(value))" />
                        </div>
                    </div>
                    <div class="gate-item">
                        <div class="who">
                            <b>Mode</b>
                            <span class="desc">Recommendation stops here for review. Auto also creates the channel request.</span>
                        </div>
                        <div class="toggle">
                            <Select TValue="AutoChannelOpenMode"
                                    SelectedValue="@_selectedNode.AutoChannelOpenMode"
                                    SelectedValueChanged="@(value => ChangeChannelOpenMode(value))"
                                    Disabled="@(_busy || !_selectedNode.AutoChannelOpenEnabled)">
                                <SelectItem TValue="AutoChannelOpenMode" Value="@AutoChannelOpenMode.Recommendation">Recommendation</SelectItem>
                                <SelectItem TValue="AutoChannelOpenMode" Value="@AutoChannelOpenMode.Auto">Auto</SelectItem>
                            </Select>
                        </div>
                    </div>
                </div>

                @if (!Constants.AUTO_CHANNEL_OPEN_ENABLED)
                {
                    <div class="gate-warn" style="margin-top:10px;">
                        <Icon Name="IconName.ExclamationTriangle" /> Automatic channel opening is globally OFF. Settings are saved, but nothing will be recommended until AUTO_CHANNEL_OPEN_ENABLED is set on the server.
                    </div>
                }
                @if (_selectedNode.AutoChannelOpenEnabled && !_selectedNode.AutoChannelOpenWalletId.HasValue)
                {
                    <div class="gate-warn" style="margin-top:10px;">
                        <Icon Name="IconName.ExclamationTriangle" /> No funding wallet is set for channel opens on this node, so it is skipped. Set one on the Nodes page.
                    </div>
                }

                @* Budget and size limits are edited on the Nodes page; shown here because a node with no
                   budget is silently skipped by the job. *@
                <div class="budget">
                    <div class="b-item">
                        <span class="k">Channel open budget</span>
                        <span class="v">@(_selectedNode.AutoChannelOpenBudgetSats is > 0 ? $"{Sats(_selectedNode.AutoChannelOpenBudgetSats.Value)} sats" : "—")</span>
                    </div>
                    <div class="b-item">
                        <span class="k">Committed this period</span>
                        <span class="v">@(_channelOpenCommittedSats is { } committed ? $"{Sats(committed)} sats" : "—")</span>
                    </div>
                </div>

                @if (_recommendations.Count == 0)
                {
                    <div class="empty">No open recommendations for this node.</div>
                }
                else
                {
                    <div class="table-wrap">
                        <table class="peers-tbl">
                            <thead>
                                <tr>
                                    <th>Peer</th>
                                    <th class="r">Payments</th>
                                    <th class="r">Missed fees</th>
                                    <th>Drain / refill</th>
                                    <th>Sizing</th>
                                    <th class="r">Opens at</th>
                                    <th class="r">Capacity (sats)</th>
                                    <th class="c">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var rec in _recommendations)
                                {
                                    <tr>
                                        <td>
                                            <div class="peer-name">
                                                <b>@(string.IsNullOrWhiteSpace(rec.PeerAlias) ? "(no alias)" : rec.PeerAlias)</b>
                                                <span class="pk mono">@StringHelper.TruncateTail(rec.PeerPubKey, 14)</span>
                                            </div>
                                        </td>
                                        <td class="r">@rec.Bursts <span class="pk">(@rec.FailedAttempts htlcs over @rec.ChannelsInvolved chan)</span></td>
                                        <td class="r">@Sats(rec.MissedFeeMsat / 1000) sats</td>
                                        <td>
                                            <span class="pk">@Sats(rec.OutSats + rec.MissedSats) out / @Sats(rec.InSats) in</span>
                                        </td>
                                        <td>
                                            <span class="cat-badge @(rec.Regime == ChannelOpenSizingRegime.Draining ? "cat-sink" : "cat-bidi")">@rec.Regime</span>
                                            @if (rec.BindingClamp != ChannelOpenBindingClamp.None)
                                            {
                                                <span class="hdr-chip" title="This clamp limited the suggested capacity">@rec.BindingClamp</span>
                                            }
                                        </td>
                                        @* The gate valued the capacity at this rate and the channel
                                           opens charging it, so it is worth seeing before promoting. *@
                                        <td class="r">
                                            @if (rec.InheritedFeeRatePpm is > 0)
                                            {
                                                <span class="pk">@rec.InheritedFeeRatePpm ppm / @(rec.InheritedBaseFeeMsat ?? 0) msat</span>
                                            }
                                            else
                                            {
                                                <span class="pk" title="Written before the opening fee was captured; the next run replaces it">—</span>
                                            }
                                        </td>
                                        <td class="r">
                                            <NumericPicker TValue="long"
                                                           Value="@GetEditedCapacity(rec)"
                                                           ValueChanged="@(v => SetEditedCapacity(rec, v))"
                                                           Min="@(_selectedNode.AutoChannelOpenMinSizeSats ?? 0)"
                                                           Max="@(_selectedNode.AutoChannelOpenMaxSizeSats ?? 21_000_000 * 100_000_000L)"
                                                           Step="100000"
                                                           Decimals="0"
                                                           Disabled="@(_busy || _selectedNode.RoutingEngineDryRun)" />
                                        </td>
                                        <td class="c">
                                            <div class="dim-actions">
                                                <button class="mini"
                                                        disabled="@(_busy || _selectedNode.RoutingEngineDryRun)"
                                                        title="@(_selectedNode.RoutingEngineDryRun ? "Node is in dry run" : "Create a pending channel open request")"
                                                        @onclick="@(() => PromoteRecommendation(rec))">
                                                    Create request
                                                </button>
                                                <button class="mini"
                                                        disabled="@_busy"
                                                        @onclick="@(() => DismissRecommendation(rec))">
                                                    Dismiss
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <!-- SEARCH -->
            <div class="searchbar">
                <Field class="grow" style="margin-bottom:0;">
                    <FieldLabel>Search peer</FieldLabel>
                    <TextEdit @bind-Text="@_search" @bind-Text:after="StateHasChanged" Placeholder="Alias or pubkey…" />
                </Field>
            </div>

            <!-- PEERS TABLE -->
            <div class="panel">
                <div class="table-wrap">
                    <table class="peers-tbl">
                        <thead>
                            <tr>
                                <th style="width:24px;"></th>
                                <th>Peer</th>
                                <th class="r">Chans</th>
                                <th class="r">Capacity</th>
                                <th>Local / Remote</th>
                                @foreach (var flag in AllFlags)
                                {
                                    <th class="c">
                                        @FlagName(flag)
                                        @* The gate panel scrolls out of view on long lists, so repeat the
                                           warning where the opt-ins actually are. *@
                                        @if (!GateOn(_selectedNode, flag))
                                        {
                                            <span class="hdr-chip" title="@GateOffWarning(flag)">gate off</span>
                                        }
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var filteredPeers = FilteredPeers().ToList();
                            }
                            @foreach (var peer in filteredPeers)
                            {
                                var expanded = _expanded.Contains(peer.PeerPubKey);
                                <tr class="peer-row">
                                    <td>
                                        <button class="expander" @onclick="@(() => ToggleExpand(peer.PeerPubKey))" title="Show channels">
                                            @(expanded ? "▾" : "▸")
                                        </button>
                                    </td>
                                    <td>
                                        <div class="peer-name">
                                            <b>@peer.PeerAlias</b>
                                            <div class="pk">@StringHelper.TruncateTail(peer.PeerPubKey, 14)</div>
                                        </div>
                                    </td>
                                    <td class="r mono">@peer.ChannelCount</td>
                                    <td class="r mono">@Btc(peer.TotalCapacitySats) BTC</td>
                                    <td>
                                        @if (peer.LocalRatio is { } ratio)
                                        {
                                            var lp = Math.Clamp(ratio, 0, 1) * 100;
                                            <div class="bal">
                                                <div class="bal-track"><div class="bal-local" style="width:@F(lp)%"></div></div>
                                                <div class="bal-meta"><span>@lp.ToString("0")% local</span><span>@peer.ActiveCount/@peer.ChannelCount active</span></div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="mono" style="color:#a7a4b5">—</span>
                                        }
                                    </td>
                                    @* Each dimension owns its badge and its own bulk actions, so a peer can be
                                       opted into fees and rebalancing independently from the same row. *@
                                    @foreach (var flag in AllFlags)
                                    {
                                        var allOn = AllEnabled(peer, flag);
                                        var noneOn = NoneEnabled(peer, flag);
                                        var cls = allOn ? "df-all" : noneOn ? "df-none" : "df-partial";
                                        <td class="c">
                                            <span class="df-badge @cls">@EnabledCount(peer, flag) / @peer.ChannelCount on</span>
                                            <div class="dim-actions">
                                                <button type="button" class="mini" disabled="@(_busy || allOn)"
                                                        @onclick="@(() => SetPeerFlag(peer, flag, true))">
                                                    Enable all
                                                </button>
                                                <button type="button" class="mini" disabled="@(_busy || noneOn)"
                                                        @onclick="@(() => SetPeerFlag(peer, flag, false))">
                                                    Disable all
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                                @if (expanded)
                                {
                                    <tr class="detail-row">
                                        <td colspan="7">
                                            <table class="detail-tbl">
                                                <thead>
                                                    <tr>
                                                        <th>Channel</th>
                                                        <th class="r">Capacity</th>
                                                        <th>Local / Remote</th>
                                                        <th class="c">Category</th>
                                                        @foreach (var flag in AllFlags)
                                                        {
                                                            <th class="c">@FlagName(flag)</th>
                                                        }
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var ch in peer.Channels)
                                                    {
                                                        <tr>
                                                            <td class="mono">@(ch.ChanId == 0 ? "(pending)" : ch.ChanId.ToString())</td>
                                                            <td class="r mono">@Btc(ch.CapacitySats) BTC</td>
                                                            <td class="mono" style="font-size:.72rem">
                                                                @if (ch.LocalBalanceSats is { } lb && ch.RemoteBalanceSats is { } rb)
                                                                {
                                                                    @($"{Sats(lb)} / {Sats(rb)}")
                                                                }
                                                                else
                                                                {
                                                                    @("—")
                                                                }
                                                            </td>
                                                            <td class="c">
                                                                @if (ch.RoutingState is { } rs)
                                                                {
                                                                    <span class="cat-badge @CategoryClass(rs.PeerFlowCategory)">@CategoryLabel(rs.PeerFlowCategory)</span>
                                                                    @if (rs.PendingCategory is { } pending)
                                                                    {
                                                                        <span class="cat-pending">→ @CategoryLabel(pending)</span>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <span class="cat-badge cat-none">—</span>
                                                                }
                                                            </td>
                                                            @foreach (var flag in AllFlags)
                                                            {
                                                                <td class="c">
                                                                    @* Pending channels (ChanId 0) aren't known to the engine yet, so they're not toggleable. *@
                                                                    <Check TValue="bool"
                                                                           Checked="@RowEnabled(ch, flag)"
                                                                           Disabled="@(_busy || ch.ChanId == 0)"
                                                                           CheckedChanged="@(value => SetChannelFlag(ch, flag, value))" />
                                                                    @* Per-dimension caveats sit under the toggle they actually affect. *@
                                                                    @if (flag == RoutingFlag.Fee && ch.BelowMinSize)
                                                                    {
                                                                        <span class="chan-tag" title="Below the engine's minimum channel size; it won't be fee-managed.">below min size</span>
                                                                    }
                                                                    @if (flag == RoutingFlag.Rebalance && ch.Active == false)
                                                                    {
                                                                        <span class="chan-tag" title="Inactive channels are never picked as a rebalance source.">inactive</span>
                                                                    }
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                }
                            }
                            @if (filteredPeers.Count == 0)
                            {
                                <tr><td colspan="7"><div class="empty">@(_peers.Count == 0 ? "This node has no open channels." : "No peers match your search.")</div></td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
</div>

@inject INodeRepository NodeRepository
@inject IChannelRepository ChannelRepository
@inject IChannelRoutingStateRepository ChannelRoutingStateRepository
@inject IRebalanceRepository RebalanceRepository
@inject IChannelOpenRecommendationRepository ChannelOpenRecommendationRepository
@inject IChannelOperationRequestRepository ChannelOperationRequestRepository
@inject IChannelOpenPromotionService ChannelOpenPromotionService
@inject IFeeEngineStateService FeeEngineStateService
@inject IAuditService AuditService
@inject ILightningService LightningService
@inject IToastService ToastService
@inject ILogger<RoutingManagement> Logger

@code {
    [CascadingParameter] private ApplicationUser? LoggedUser { get; set; }

    // The two routing-engine actuators this page opts channels into. They share the node gate + peer table
    // shape, so every mutation below takes the dimension it acts on rather than duplicating the flow.
    private enum RoutingFlag { Fee, Rebalance }

    private static readonly RoutingFlag[] AllFlags = { RoutingFlag.Fee, RoutingFlag.Rebalance };

    private List<Node> _managedNodes = new();
    private int? _selectedNodeId;
    private Node? _selectedNode;
    private List<Channel> _channels = new();
    private List<Channel> _nodeChannels = new();
    private IReadOnlyDictionary<ulong, ChannelState>? _live;
    private Dictionary<int, ChannelRoutingState> _routingStates = new();
    private List<PeerOverview> _peers = new();
    private readonly HashSet<string> _expanded = new();
    private string _search = string.Empty;
    private bool _loading = true;
    // Busy flag to prevent overlapping mutations (node gates or channel toggles) and keep the UI in sync.
    private bool _busy;
    // Rebalance budget stats — null when not loaded yet or unavailable.
    private long? _rebalanceConsumedSats;
    private int? _rebalanceInFlight;

    private List<ChannelOpenRecommendation> _recommendations = new();
    private readonly Dictionary<int, long> _editedCapacities = new();
    private long? _channelOpenCommittedSats;

    protected override async Task OnInitializedAsync()
    {
        if (LoggedUser is null) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (LoggedUser is null) return;
        _loading = true;
        try
        {
            _managedNodes = await NodeRepository.GetAllManagedByUser(LoggedUser.Id);
            _selectedNodeId ??= _managedNodes.FirstOrDefault()?.Id;
            _selectedNode = _managedNodes.FirstOrDefault(n => n.Id == _selectedNodeId);

            var allChannels = await ChannelRepository.GetAllManagedByUserNodes(LoggedUser.Id);
            _channels = allChannels.Where(c => c.Status == Channel.ChannelStatus.Open).ToList();

            await LoadRoutingStatesAsync();

            // Live balances are best-effort — structural stats and the toggles still work without LND.
            _live = null;
            try
            {
                var state = await LightningService.GetChannelsState();
                if (state.Count > 0) _live = state;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not fetch live channel balances for the Routing Management page");
            }

            Rebuild();
            await LoadRebalanceStatsAsync();
            await LoadChannelOpenStatsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading Routing Management page");
            ToastService.ShowError("Could not load peers.");
        }
        finally
        {
            _loading = false;
        }
    }

    // Recompute the selected node's channel slice and group it by remote peer.
    private void Rebuild()
    {
        if (_selectedNode is null)
        {
            _nodeChannels = new();
            _peers = new();
            return;
        }

        _nodeChannels = _channels
            .Where(c => c.SourceNodeId == _selectedNode.Id || c.DestinationNodeId == _selectedNode.Id)
            .ToList();

        var groups = new Dictionary<string, PeerOverview>();
        foreach (var channel in _nodeChannels)
        {
            var src = channel.SourceNode;
            var dst = channel.DestinationNode;
            if (src is null || dst is null) continue;

            var peerNode = src.PubKey == _selectedNode.PubKey ? dst : src;

            if (!groups.TryGetValue(peerNode.PubKey, out var overview))
            {
                overview = new PeerOverview
                {
                    PeerPubKey = peerNode.PubKey,
                    PeerAlias = !string.IsNullOrWhiteSpace(peerNode.Name)
                        ? peerNode.Name
                        : StringHelper.TruncateTail(peerNode.PubKey, 12),
                };
                groups[peerNode.PubKey] = overview;
            }

            ChannelState? live = null;
            _live?.TryGetValue(channel.ChanId, out live);

            _routingStates.TryGetValue(channel.Id, out var routingState);

            overview.Channels.Add(new PeerChannelRow
            {
                Channel = channel,
                ChanId = channel.ChanId,
                CapacitySats = channel.SatsAmount,
                IsDynamicFeeEnabled = channel.IsDynamicFeeEnabled,
                IsAutoRebalanceEnabled = channel.IsAutoRebalanceEnabled,
                LocalBalanceSats = live?.LocalBalance,
                RemoteBalanceSats = live?.RemoteBalance,
                Active = live?.Active,
                BelowMinSize = channel.SatsAmount < Constants.ROUTING_ENGINE_FEE_MIN_CHANNEL_SIZE_SATS,
                RoutingState = routingState,
            });
        }

        _peers = groups.Values
            .OrderByDescending(o => o.TotalCapacitySats)
            .ThenBy(o => o.PeerAlias)
            .ToList();
    }

    // Re-read nodes and channels from the DB after a mutation so subsequent actions operate on fresh
    // entities (matching the other node/channel pages). Live balances are unaffected
    // by a flag toggle, so they're not re-fetched here.
    private async Task ReloadEntitiesAsync()
    {
        if (LoggedUser is null) return;
        _managedNodes = await NodeRepository.GetAllManagedByUser(LoggedUser.Id);
        _selectedNode = _managedNodes.FirstOrDefault(n => n.Id == _selectedNodeId);
        var allChannels = await ChannelRepository.GetAllManagedByUserNodes(LoggedUser.Id);
        _channels = allChannels.Where(c => c.Status == Channel.ChannelStatus.Open).ToList();
        Rebuild();
        await LoadRebalanceStatsAsync();
        await LoadChannelOpenStatsAsync();
    }

    // Budget spend and in-flight count for the rebalance read-out. Best-effort: the page still works without them.
    private async Task LoadRebalanceStatsAsync()
    {
        _rebalanceConsumedSats = null;
        _rebalanceInFlight = null;
        if (_selectedNode is null) return;
        try
        {
            // Mirror AutoRebalanceJob: consumption is measured from the current budget period's start.
            var periodStart = _selectedNode.RebalanceBudgetStartDatetime ?? DateTimeOffset.UtcNow;
            _rebalanceConsumedSats = await RebalanceRepository.GetConsumedFeesSince(_selectedNode.Id, periodStart);
            _rebalanceInFlight = await RebalanceRepository.GetInFlightByNode(_selectedNode.Id);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load rebalance budget stats for node {NodeId}", _selectedNode.Id);
        }
    }

    private async Task OnNodeChanged()
    {
        _selectedNode = _managedNodes.FirstOrDefault(n => n.Id == _selectedNodeId);
        _expanded.Clear();
        _search = string.Empty;
        await LoadRoutingStatesAsync();
        await LoadRebalanceStatsAsync();
        await LoadChannelOpenStatsAsync();
        Rebuild();
    }

    // Routing state is per managed node, so it's re-read whenever the selected node changes.
    // Best-effort: categories just render as "—" when it can't be loaded.
    private async Task LoadRoutingStatesAsync()
    {
        _routingStates = new();
        if (_selectedNode is null) return;
        try
        {
            var states = await ChannelRoutingStateRepository.GetByManagedNodePubKey(_selectedNode.PubKey);
            _routingStates = states.ToDictionary(s => s.ChannelId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load routing state for node {PubKey}", _selectedNode.PubKey);
        }
    }

    private IEnumerable<PeerOverview> FilteredPeers()
    {
        if (string.IsNullOrWhiteSpace(_search)) return _peers;
        var q = _search.Trim();
        return _peers.Where(p =>
            p.PeerAlias.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            p.PeerPubKey.Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private void ToggleExpand(string peerPubKey)
    {
        if (!_expanded.Remove(peerPubKey)) _expanded.Add(peerPubKey);
    }

    #region Dimension accessors

    private static bool GateOn(Node node, RoutingFlag flag) =>
        flag == RoutingFlag.Fee ? node.DynamicFeeManagementEnabled : node.AutoRebalanceEnabled;

    private static int EnabledCount(PeerOverview peer, RoutingFlag flag) =>
        flag == RoutingFlag.Fee ? peer.DynamicFeeEnabledCount : peer.AutoRebalanceEnabledCount;

    private static bool AllEnabled(PeerOverview peer, RoutingFlag flag) =>
        peer.ChannelCount > 0 && EnabledCount(peer, flag) == peer.ChannelCount;

    private static bool NoneEnabled(PeerOverview peer, RoutingFlag flag) => EnabledCount(peer, flag) == 0;

    private static bool RowEnabled(PeerChannelRow row, RoutingFlag flag) =>
        flag == RoutingFlag.Fee ? row.IsDynamicFeeEnabled : row.IsAutoRebalanceEnabled;

    private static bool GetFlag(Channel channel, RoutingFlag flag) =>
        flag == RoutingFlag.Fee ? channel.IsDynamicFeeEnabled : channel.IsAutoRebalanceEnabled;

    private static void SetFlag(Channel channel, RoutingFlag flag, bool enabled)
    {
        if (flag == RoutingFlag.Fee)
        {
            channel.IsDynamicFeeEnabled = enabled;
        }
        else
        {
            channel.IsAutoRebalanceEnabled = enabled;
        }
    }

    private static void SetGate(Node node, RoutingFlag flag, bool enabled)
    {
        if (flag == RoutingFlag.Fee)
        {
            node.DynamicFeeManagementEnabled = enabled;
        }
        else
        {
            node.AutoRebalanceEnabled = enabled;
        }
    }

    // Column headings and toast wording.
    private static string FlagName(RoutingFlag flag) =>
        flag == RoutingFlag.Fee ? "Dynamic fees" : "Automatic rebalances";

    // Node-gate wording, kept in step with the Nodes page.
    private static string GateName(RoutingFlag flag) =>
        flag == RoutingFlag.Fee ? "Dynamic fee management" : "Automated rebalancing";

    // Lower-case noun used in audit lines and logs.
    private static string FlagAudit(RoutingFlag flag) =>
        flag == RoutingFlag.Fee ? "dynamic fee" : "auto-rebalance source";

    private static string GateDescription(RoutingFlag flag) =>
        flag == RoutingFlag.Fee
            ? "lets the engine move this node's channel fees"
            : "lets the engine start circular rebalances on this node";

    private static string GateOffWarning(RoutingFlag flag) =>
        flag == RoutingFlag.Fee
            ? "Dynamic fees gate is off — opting channels in below won't move any fees until you turn it on."
            : "Automatic rebalances gate is off — opting channels in below won't start any rebalance until you turn it on.";

    #endregion Dimension accessors

    // Recommendations and budget read-out for the channel-open panel. Best-effort: the rest of the
    // page still works when these cannot be loaded.
    private async Task LoadChannelOpenStatsAsync()
    {
        _recommendations = new List<ChannelOpenRecommendation>();
        _editedCapacities.Clear();
        _channelOpenCommittedSats = null;
        if (_selectedNode is null) return;
        try
        {
            // Mirror AutoChannelOpenJob: consumption is measured from the current budget period's start.
            var periodStart = _selectedNode.AutoChannelOpenBudgetStartDatetime ?? DateTimeOffset.UtcNow;

            // Independent reads, each on its own DbContext from the factory — one round-trip instead of two.
            var recommendations = ChannelOpenRecommendationRepository.GetOpenByNode(_selectedNode.Id);
            var committed = ChannelOperationRequestRepository.GetOpenSatsCommittedSince(_selectedNode.Id, periodStart);
            await Task.WhenAll(recommendations, committed);

            _recommendations = recommendations.Result;
            _channelOpenCommittedSats = committed.Result;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not load channel open recommendations for node {NodeId}", _selectedNode.Id);
        }
    }

    // The suggested capacity is a starting point: an operator edits it here before promoting.
    private long GetEditedCapacity(ChannelOpenRecommendation rec)
        => _editedCapacities.TryGetValue(rec.Id, out var edited) ? edited : rec.SuggestedCapacitySats;

    private void SetEditedCapacity(ChannelOpenRecommendation rec, long value) => _editedCapacities[rec.Id] = value;

    /// <summary>
    /// Optimistically applies a node change, rolling it back and reporting if the write fails.
    /// Shared by every node-level gate so they cannot drift apart in their error handling.
    /// </summary>
    private async Task<bool> PersistNodeChange(Action apply, Action rollback, string what)
    {
        if (_selectedNode is null) return false;

        apply();
        var (ok, _) = NodeRepository.Update(_selectedNode);
        if (ok)
        {
            await AuditService.LogAsync(AuditActionType.Update, AuditEventType.Success, AuditObjectType.Node,
                _selectedNode.Id.ToString(), $"{what} via Routing Management page.");
            return true;
        }

        rollback();
        // Repository.Update swallows the exception and returns a null reason, so log it and
        // record the attempt in the audit trail like every other routing mutation does.
        Logger.LogError("Failed to persist change for node {Node} ({PubKey}): {What}", _selectedNode.Name, _selectedNode.PubKey, what);
        await AuditService.LogAsync(AuditActionType.Update, AuditEventType.Failure, AuditObjectType.Node,
            _selectedNode.Id.ToString(), $"Failed: {what} via Routing Management page.");
        ToastService.ShowError($"Could not update {_selectedNode.Name}. Check the logs for details.");
        return false;
    }

    private async Task ToggleChannelOpenGate(bool enabled)
    {
        if (_busy || _selectedNode is null || _selectedNode.AutoChannelOpenEnabled == enabled) return;
        _busy = true;
        try
        {
            var node = _selectedNode;
            if (await PersistNodeChange(
                    () => node.AutoChannelOpenEnabled = enabled,
                    () => node.AutoChannelOpenEnabled = !enabled,
                    $"Auto channel open {(enabled ? "enabled" : "disabled")}"))
            {
                ToastService.ShowSuccess($"Auto channel open {(enabled ? "enabled" : "disabled")} for {node.Name}.");
                await ReloadEntitiesAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangeChannelOpenMode(AutoChannelOpenMode mode)
    {
        if (_busy || _selectedNode is null || _selectedNode.AutoChannelOpenMode == mode) return;
        _busy = true;
        try
        {
            var node = _selectedNode;
            var previous = node.AutoChannelOpenMode;
            if (await PersistNodeChange(
                    () => node.AutoChannelOpenMode = mode,
                    () => node.AutoChannelOpenMode = previous,
                    $"Auto channel open mode set to {mode}"))
            {
                ToastService.ShowSuccess($"Auto channel open mode set to {mode} for {node.Name}.");
                await ReloadEntitiesAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task PromoteRecommendation(ChannelOpenRecommendation rec)
    {
        if (_busy || LoggedUser is null) return;
        _busy = true;
        try
        {
            var capacity = GetEditedCapacity(rec);
            var (ok, error) = await ChannelOpenPromotionService.Promote(rec.Id, capacity, LoggedUser.Id);
            if (!ok)
            {
                ToastService.ShowError(error ?? "Could not create the channel open request.");
                return;
            }

            ToastService.ShowSuccess($"Channel open request created for {capacity} sats. Approve it on the Channel Requests page.");
            await LoadChannelOpenStatsAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DismissRecommendation(ChannelOpenRecommendation rec)
    {
        if (_busy || LoggedUser is null) return;
        _busy = true;
        try
        {
            var (ok, error) = await ChannelOpenPromotionService.Dismiss(rec.Id, "Dismissed from the Routing Management page", LoggedUser.Id);
            if (!ok)
            {
                ToastService.ShowError(error ?? "Could not dismiss the recommendation.");
                return;
            }

            ToastService.ShowSuccess("Recommendation dismissed.");
            await LoadChannelOpenStatsAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleNodeGate(RoutingFlag flag, bool enabled)
    {
        if (_busy || _selectedNode is null || GateOn(_selectedNode, flag) == enabled) return;
        _busy = true;
        try
        {
            var node = _selectedNode;
            if (await PersistNodeChange(
                    () => SetGate(node, flag, enabled),
                    () => SetGate(node, flag, !enabled),
                    $"{GateName(flag)} {(enabled ? "enabled" : "disabled")}"))
            {
                // Disabling the node's fee gate purges its channels' fee-engine state (mirrors Nodes page).
                // The rebalancer keeps no per-channel state, so there is nothing to purge for that gate.
                if (flag == RoutingFlag.Fee)
                {
                    await FeeEngineStateService.PurgeNodeStateIfDisabled(node);
                }

                ToastService.ShowSuccess($"{GateName(flag)} {(enabled ? "enabled" : "disabled")} for {node.Name}.");

                // A node with no budget is skipped outright by AutoRebalanceJob, so say so on the way in.
                if (flag == RoutingFlag.Rebalance && enabled && (node.RebalanceBudgetSats ?? 0) <= 0)
                {
                    ToastService.ShowWarning("Heads up: this node has no rebalance fee budget, so the rebalancer will skip it. Set one on the Nodes page.");
                }

                await ReloadEntitiesAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetPeerFlag(PeerOverview peer, RoutingFlag flag, bool enabled)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var (updated, failed) = await ApplyFlagAsync(peer.Channels.Select(c => c.Channel), flag, enabled);

            if (failed > 0)
            {
                ToastService.ShowWarning($"{updated} channel(s) updated, {failed} failed — check logs.");
            }
            else if (updated == 0)
            {
                ToastService.ShowInfo("No changes — channels were already in that state.");
            }
            else
            {
                ToastService.ShowSuccess($"{FlagName(flag)} {(enabled ? "enabled" : "disabled")} on {updated} channel(s) for {peer.PeerAlias}.");
            }

            if (enabled && _selectedNode is not null && !GateOn(_selectedNode, flag))
            {
                ToastService.ShowWarning($"Heads up: this node's {GateName(flag).ToLowerInvariant()} gate is off, so nothing will happen until you enable it above.");
            }

            await ReloadEntitiesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetChannelFlag(PeerChannelRow row, RoutingFlag flag, bool enabled)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var (updated, failed) = await ApplyFlagAsync(new[] { row.Channel }, flag, enabled);
            if (failed > 0)
            {
                ToastService.ShowError("Could not update the channel.");
            }
            else if (updated > 0)
            {
                ToastService.ShowSuccess($"{FlagName(flag)} {(enabled ? "enabled" : "disabled")} for channel {row.ChanId}.");
            }
            await ReloadEntitiesAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    // Bulk-sets one dimension's flag across channels: persists each, audits it, and (for the fee dimension)
    // purges fee-engine state on opt-out. Channels already at the target — or pending (ChanId 0), which
    // the engine can't manage yet — are skipped. Returns how many changed and how many failed to persist.
    private async Task<(int updated, int failed)> ApplyFlagAsync(IEnumerable<Channel> channels, RoutingFlag flag, bool enabled)
    {
        var updated = 0;
        var failed = 0;

        foreach (var channel in channels)
        {
            if (GetFlag(channel, flag) == enabled) continue;
            if (enabled && channel.ChanId == 0) continue; // pending channels aren't known to the engine yet

            SetFlag(channel, flag, enabled);
            var (ok, error) = ChannelRepository.Update(channel);
            if (!ok)
            {
                SetFlag(channel, flag, !enabled); // revert the in-memory flag on persistence failure
                failed++;
                var reason = string.IsNullOrWhiteSpace(error) ? "persistence failed" : error;
                Logger.LogError("Bulk {Flag} update failed for channel {ChanId}: {Error}", FlagAudit(flag), channel.ChanId, reason);
                await AuditService.LogAsync(AuditActionType.Update, AuditEventType.Failure, AuditObjectType.Channel,
                    channel.Id.ToString(), $"Bulk {FlagAudit(flag)} update failed. ChanId: {channel.ChanId}, target: {enabled}. {reason}");
                continue;
            }

            await AuditService.LogAsync(AuditActionType.Update, AuditEventType.Success, AuditObjectType.Channel,
                channel.Id.ToString(), $"Bulk {(enabled ? "enabled" : "disabled")} {FlagAudit(flag)} via Routing Management page. ChanId: {channel.ChanId}");

            // Mirror the single-channel flow: drop opted-out fee state so a later re-enable cold-starts.
            if (flag == RoutingFlag.Fee)
            {
                await FeeEngineStateService.PurgeChannelStateIfDisabled(channel);
            }

            updated++;
        }

        return (updated, failed);
    }

    private static string CategoryLabel(PeerFlowCategory category) => category switch
    {
        PeerFlowCategory.Sink => "Sink",
        PeerFlowCategory.Source => "Source",
        PeerFlowCategory.Bidirectional => "Bidirectional",
        PeerFlowCategory.Idle => "Idle",
        _ => "Uncategorized",
    };

    private static string CategoryClass(PeerFlowCategory category) => category switch
    {
        PeerFlowCategory.Sink => "cat-sink",
        PeerFlowCategory.Source => "cat-source",
        PeerFlowCategory.Bidirectional => "cat-bidi",
        PeerFlowCategory.Idle => "cat-idle",
        _ => "cat-uncat",
    };

    private static string Btc(long sats) => (sats / 100_000_000m).ToString("0.####");
    private static string Sats(long sats) => sats.ToString("N0");
    private static string F(double d) => d.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    // The rebalancer falls back to ROUTING_ENGINE_REBALANCE_DEFAULT_BUDGET_REFRESH_HOURS when the node
    // leaves the interval unset, so show the effective value rather than a dash.
    private static string BudgetRefreshText(Node node)
    {
        var interval = node.RebalanceBudgetRefreshInterval
                       ?? TimeSpan.FromHours(Constants.ROUTING_ENGINE_REBALANCE_DEFAULT_BUDGET_REFRESH_HOURS);
        return interval.TotalHours >= 24 && interval.TotalHours % 24 == 0
            ? $"every {F(interval.TotalDays)} d"
            : $"every {F(interval.TotalHours)} h";
    }

    // One remote peer and every channel the selected node holds to it, with structural fee/liquidity stats.
    private sealed class PeerOverview
    {
        public string PeerPubKey { get; init; } = string.Empty;
        public string PeerAlias { get; init; } = string.Empty;
        public List<PeerChannelRow> Channels { get; } = new();

        public int ChannelCount => Channels.Count;
        public long TotalCapacitySats => Channels.Sum(c => c.CapacitySats);
        public int DynamicFeeEnabledCount => Channels.Count(c => c.IsDynamicFeeEnabled);
        public int AutoRebalanceEnabledCount => Channels.Count(c => c.IsAutoRebalanceEnabled);
        public int ActiveCount => Channels.Count(c => c.Active == true);

        // Only aggregate a local/remote split when EVERY channel to the peer has live data; summing over
        // a partial set would let unreported channels contribute 0/0 and skew the ratio.
        private bool HasLive => Channels.Count > 0 && Channels.All(c => c.LocalBalanceSats.HasValue && c.RemoteBalanceSats.HasValue);
        public long? LocalBalanceSats => HasLive ? Channels.Sum(c => c.LocalBalanceSats!.Value) : null;
        public long? RemoteBalanceSats => HasLive ? Channels.Sum(c => c.RemoteBalanceSats!.Value) : null;
        public double? LocalRatio => LocalBalanceSats is { } l && RemoteBalanceSats is { } r && (l + r) > 0
            ? (double)l / (l + r)
            : null;
    }

    // A single channel to a peer, as shown in the expandable detail.
    private sealed class PeerChannelRow
    {
        public required Channel Channel { get; init; }
        public ulong ChanId { get; init; }
        public long CapacitySats { get; init; }
        public bool IsDynamicFeeEnabled { get; init; }
        public bool IsAutoRebalanceEnabled { get; init; }
        public long? LocalBalanceSats { get; init; }
        public long? RemoteBalanceSats { get; init; }
        public bool? Active { get; init; }
        public bool BelowMinSize { get; init; } // below the engine's minimum size, so it won't be fee-managed
        public ChannelRoutingState? RoutingState { get; init; } // null until the engine has evaluated the channel
    }
}

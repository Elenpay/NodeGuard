@using System.Text.Json
@using Blazorise.Extensions
@using NBXplorer.DerivationStrategy
@using NBXplorer.Models
@using NBitcoin
@using NodeGuard.Jobs
@using Quartz
@inject IPriceConversionService PriceConversionService
@inject IBitcoinService BitcoinService
@inject IToastService ToastService
@inject ILightningService LightningService
@inject IWalletWithdrawalRequestRepository WalletWithdrawalRequestRepository
@inject IAuditService AuditService
@inject IWalletWithdrawalRequestPsbtRepository WalletWithdrawalRequestPsbtRepository
@inject ISchedulerFactory SchedulerFactory
@inject IWalletRepository WalletRepository
@inject ILogger<TransferFundsModal> Logger
@inject ICoinSelectionService CoinSelectionService

<Modal @ref="@_transferFundsModal">
    <ModalContent Centered Size="@ModalSize.Large">
        <ModalHeader>
            <ModalTitle>Transfer funds to another wallet</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Fields>
                <Validations @ref="@_transferFundsValidations">
                    <div class="row w-100">
                        <div class="col-12">
                            <Field>
                                <FieldLabel>Description</FieldLabel>
                                <FieldBody>
                                    <TextEdit @bind-Value="@_description" />
                                </FieldBody>
                            </Field>
                        </div>
                    </div>
                    <div class="row w-100 justify-content-between">
                        <div class="col">
                            <Field>
                                <FieldLabel><strong>From</strong> (this wallet)</FieldLabel>
                                <FieldBody>
                                    <SelectList TItem="@Wallet" TValue="@int" DefaultItemDisabled
                                                Data="@_walletsForTransfer" TextField="@((item) => item.Name)"
                                                ValueField="@((item) => item.Id)"
                                                SelectedValue="@(_sourceTransferWallet?.Id ?? 0)"
                                                SelectedValueChanged="@OnSourceWalletSelected"
                                                DefaultItemText="Choose the wallet" Disabled="@_sourceWalletSelectionDisabled">
                                        <Feedback>
                                            <ValidationError>You must select a valid wallet</ValidationError>
                                        </Feedback>
                                    </SelectList>
                                    @if (_sourceTransferWallet != null && _availableUTXOs.Count == 0)
                                    {
                                        <div class="text-danger small p-1">Wallet has no available UTXOs</div>
                                    }
                                </FieldBody>
                                <FieldHelp class="field-help">
                                    @($"Current balance: {_sourceWalletBalanceFormatted}");
                                </FieldHelp>
                                <FieldHelp>
                                    @GetWalletBalanceFormatted(CalculateAmountWalletSourceAfterTransaction(), "Balance after transfer:")
                                </FieldHelp>
                            </Field>
                        </div>
                        <div class="arrow-icon-container">
                            <div>
                                <Icon Name="@IconName.ArrowRight" class="arrow-icon" />
                            </div>
                        </div>
                        <div class="col">
                            <Validation Validator="@ValidationRule.IsSelected">
                                <Field>
                                    <FieldLabel>
                                        <strong>To</strong>
                                    </FieldLabel>
                                    <FieldBody>
                                        <SelectList TItem="@Wallet" TValue="@int" DefaultItemDisabled
                                                    Data="@_walletsForTransfer" TextField="@((item) => item.Name)"
                                                    ValueField="@((item) => item.Id)"
                                                    SelectedValue="@(_targetTransferWallet?.Id ?? 0)"
                                                    SelectedValueChanged="@OnTargetWalletSelected"
                                                    DefaultItemText="Choose the wallet">
                                            <Feedback>
                                                <ValidationError>You must select a valid wallet</ValidationError>
                                            </Feedback>
                                        </SelectList>
                                    </FieldBody>
                                    <FieldHelp
                                        Visibility="@(_targetTransferWallet == null ? Visibility.Invisible : Visibility.Visible)">
                                        @($"Current balance: {_targetWalletBalanceFormatted}")
                                    </FieldHelp>
                                    <FieldHelp
                                        Visibility="@(_targetTransferWallet == null ? Visibility.Invisible : Visibility.Visible)">
                                        @GetWalletBalanceFormatted(CalculateAmountWalletTargetAfterTransaction(),
                        "Balance after transfer:")
                                    </FieldHelp>
                                </Field>
                            </Validation>
                        </div>
                    </div>
                    <div class="row w-100">
                        <div class="col-6">
                            <Field>
                                <FieldBody>
                                    <Check TValue="@bool" CheckedChanged="@OnTransferAllFundsCheckedChanged"
                                           Checked="@_transferAllFunds">Transfer all funds</Check>
                                </FieldBody>
                            </Field>
                        </div>
                    </div>
                    <div class="row w-100 justify-content-between">
                        <div class="col-6">
                            <Validation
                                Validator="@((args) => ValidationHelper.ValidateWithdrawalAmount(args, AvailableBalance))">
                                <Field>
                                    <FieldLabel>Amount</FieldLabel>
                                    <FieldBody>
                                        <NumericPicker TValue="@decimal" Disabled="@_transferAllFunds"
                                                       @bind-Value="@_amountToTransfer" CurrencySymbol="₿ " Max="@_maxWithdrawal"
                                                       Min="@_minWithdrawal" Decimals="8" />
                                    </FieldBody>
                                    <FieldHelp>
                                        @($"Current amount:                                        {Math.Round(PriceConversionService.BtcToUsdConversion((decimal)
                                        _amountToTransfer, BTCPrice), 2)} USD")
                                    </FieldHelp>
                                </Field>
                            </Validation>
                        </div>
                        <div class="col-6 d-flex flex-column align-items-center justify-content-center">
                            <div class="d-flex gap-2 flex-wrap justify-content-center">
                                <Button Color="@Color.Primary"
                                        Disabled="@(_sourceTransferWallet == null || _transferAllFunds)"
                                        Clicked="@OpenCoinSelectionModal">Select Coins</Button>
                                <Button Color="@Color.Primary" Disabled="@(_selectedUTXOs.Count == 0)"
                                        Clicked="@ClearSelectedUTXOs">Default Coin Selection</Button>
                            </div>
                            @if (_sourceTransferWallet != null && _selectedUTXOs.Count > 0)
                            {
                                <span class="text-danger">
                                    Selected @(_selectedUTXOs.Count) UTXOs, this is a changeless
                                    operation
                                </span>
                            }
                            else
                            {
                                <span class="text-danger">Default coin selection strategy selected</span>
                            }
                        </div>
                    </div>
                    <div class="row w-100">
                        <div class="col-12">
                            <Field Width="@Width.Is100">
                                <FieldLabel>Fee Rate</FieldLabel>
                                <FeeRateSelector @bind-SelectedFeeType="@_selectedMempoolRecommendedFeesType"
                                                 @bind-CustomSatPerVb="@_customSatPerVbAmount"
                                                 ContainerClass="transfer-fee-control-gap" />
                            </Field>
                        </div>
                    </div>
                </Validations>
            </Fields>
        </ModalBody>
        <ModalFooter>
            <Button Color="@Color.Secondary" Clicked="@CloseAndCleanTransferFundsModal">Close</Button>
            <Button Color="@Color.Primary" Clicked="@ValidateAndSelectConfirmModal"
                    Disabled="@(_sourceTransferWallet == null || _availableUTXOs.Count == 0)">Transfer</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<ConfirmationModal @ref="_multisigTransferModal" Title="Transferring from a multisig wallet"
                   Body="Your transfer request was succesfully done. Please, go to Withdrawals page to sign for this transfer."
                   CancelLabel="Yes, understood" OnCancel="CloseMultisigTransferModal" />
<ConfirmationModal @ref="_hotWalletTransferModal" Title="Are you sure?"
                   Body="You're about to transfer funds from this wallet. This means that the system will automatically use the funds in it without the need of manual approval. Are you sure you want to perform this operation?"
                   OkLabel="Yes, understood" OnCancel="CloseHotWalletTransferModal" OnSubmit="TransferFundsHotWallet" />
<UTXOSelectorModal @ref="_utxoSelectorModalRef" OnClose="@OnCloseCoinSelectionModal"
                   IsWalletWithdrawalValidation="true" />

@code {
    #region Parameters
    [CascadingParameter]
    private ApplicationUser? LoggedUser { get; set; }
    [Parameter]
    public decimal BTCPrice { get; set; }
    #endregion

    #region Refs
    private Modal _transferFundsModal = default!;
    private Validations _transferFundsValidations = default!;
    private ConfirmationModal _hotWalletTransferModal = default!;
    private ConfirmationModal _multisigTransferModal = default!;
    private UTXOSelectorModal _utxoSelectorModalRef = default!;
    #endregion

    #region Fields
    private bool _sourceWalletSelectionDisabled = true;
    private List<Wallet> _walletsForTransfer = new();
    private List<UTXO> _selectedUTXOs = new();
    private List<UTXO> _availableUTXOs = new();

    private bool _transferAllFunds;
    private decimal _amountToTransfer;
    private decimal _maxWithdrawal = Constants.MAXIMUM_WITHDRAWAL_BTC_AMOUNT;
    private decimal _minWithdrawal = Constants.MINIMUM_WITHDRAWAL_BTC_AMOUNT;

    private string? _description;
    private MempoolRecommendedFeesType _selectedMempoolRecommendedFeesType;
    private long _customSatPerVbAmount = 1;

    private Wallet? _sourceTransferWallet;
    private string _sourceWalletName => _sourceTransferWallet != null ? $"{_sourceTransferWallet.Name} " : "";
    private decimal _sourceWalletBalance;
    private string? _sourceWalletBalanceFormatted => GetWalletBalanceFormatted(_sourceWalletBalance);
    private decimal AvailableBalance => _availableUTXOs.Count > 0
        ? _availableUTXOs.Sum(x => ((Money)x.Value).ToUnit(MoneyUnit.BTC))
        : _sourceWalletBalance;
    private decimal _sourceBalanceAfterTransaction => _sourceWalletBalance > _amountToTransfer ? _sourceWalletBalance -
_amountToTransfer : 0;

    private Wallet? _targetTransferWallet;
    private string _targetWalletName => _targetTransferWallet != null ? $"{_targetTransferWallet.Name} " : "";
    private decimal _targetWalletBalance;
    private string? _targetWalletBalanceFormatted => GetWalletBalanceFormatted(_targetWalletBalance);
    #endregion

    private string GetWalletBalanceFormatted(decimal balance, string prefix = "")
    {
        return $"{prefix} {balance:f8} BTC ({Math.Round(PriceConversionService.BtcToUsdConversion((decimal)balance, BTCPrice),
2)} USD)";
    }

    private async Task OnTransferAllFundsCheckedChanged(bool value)
    {
        _transferAllFunds = value;
        if (_transferAllFunds)
        {
            _amountToTransfer = AvailableBalance;
            ClearSelectedUTXOs();
        }
        await _transferFundsValidations.ClearAll();
    }

    private decimal CalculateAmountWalletSourceAfterTransaction()
    {
        if (_transferAllFunds)
        {
            return 0;
        }
        return _sourceBalanceAfterTransaction;
    }

    private async Task GetAvailableUTXOsForWallet(Wallet? wallet)
    {
        if (wallet == null)
        {
            _availableUTXOs.Clear();
            return;
        }

        var strategy = wallet.GetDerivationStrategy();
        if (strategy == null)
        {
            ToastService.ShowError("There was an error while getting the derivation strategy for the selected wallet. Please, try again.");
            return;
        }

        var utxos = await CoinSelectionService.GetAvailableUTXOsAsync(strategy);
        _availableUTXOs = utxos.ToList();
    }

    private async Task OnSourceWalletSelected(int id)
    {
        var wallet = _walletsForTransfer.SingleOrDefault(x => x.Id == id);
        _sourceTransferWallet = wallet;
        _selectedUTXOs.Clear();

        if (wallet != null)
        {
            (_sourceWalletBalance, _) = await BitcoinService.GetWalletConfirmedBalance(wallet);
            await GetAvailableUTXOsForWallet(wallet);
        }
        else
        {
            _sourceWalletBalance = 0;
            _availableUTXOs.Clear();
        }
    }

    private async Task OnTargetWalletSelected(int id)
    {
        var wallet = _walletsForTransfer.SingleOrDefault(x => x.Id == id);
        _targetTransferWallet = wallet;

        if (wallet != null)
        {
            (_targetWalletBalance, _) = await BitcoinService.GetWalletConfirmedBalance(wallet);
        }
        else
        {
            _targetWalletBalance = 0;
        }
    }

    private decimal CalculateAmountWalletTargetAfterTransaction()
    {
        decimal amount = _transferAllFunds ? _targetWalletBalance + _sourceWalletBalance : _targetWalletBalance +
_amountToTransfer;
        return amount;
    }

    private async Task<WalletWithdrawalRequest> CreateWithdrawalRequestForFunds(Wallet source, Wallet destination, decimal
     amount, bool transferAllFunds)
    {
        var targetBitcoinAddress = await LightningService.GetUnusedAddress(destination, DerivationFeature.Deposit);
        if (targetBitcoinAddress == null)
        {
            throw new ShowToUserException("There was an error while generating a new address for the target wallet. Please, try again.");
        }

        var withdrawalRequest = new WalletWithdrawalRequest
        {
            UserRequestorId = LoggedUser != null ? LoggedUser.Id : string.Empty,
            RequestMetadata = JsonSerializer.Serialize(new
            {
                userName = LoggedUser?.UserName ?? ""
            }),
            Description = _description ?? string.Empty,
            WithdrawAllFunds = _transferAllFunds || _amountToTransfer == _sourceWalletBalance,
            Changeless = _selectedUTXOs.Count > 0,
            MempoolRecommendedFeesType = _selectedMempoolRecommendedFeesType,
            CustomFeeRate = _customSatPerVbAmount,
            WalletWithdrawalRequestDestinations = new List<WalletWithdrawalRequestDestination>
             {
                 new WalletWithdrawalRequestDestination
                 {
                     Address = targetBitcoinAddress.ToString(),
                     Amount = amount,
                 }
             },
            WalletId = source.Id,
            Status = source.IsHotWallet
                         ? WalletWithdrawalRequestStatus.PSBTSignaturesPending
                         : WalletWithdrawalRequestStatus.Pending,
        };

        var (success, error) = await WalletWithdrawalRequestRepository.AddAsync(withdrawalRequest);
        if (!success)
        {
            throw new ShowToUserException($"Error while creating the withdrawal request: {error}");
        }

        if (success && _selectedUTXOs.Count > 0)
        {
            await CoinSelectionService.LockUTXOs(_selectedUTXOs, withdrawalRequest, BitcoinRequestType.WalletWithdrawal);
        }

        return withdrawalRequest;
    }

    private async Task CloseMultisigTransferModal()
    {
        await _multisigTransferModal.CloseModal();
    }

    private async Task CloseHotWalletTransferModal()
    {
        await _hotWalletTransferModal.CloseModal();
    }

    private async Task ValidateAndSelectConfirmModal()
    {
        try
        {
            if (!await _transferFundsValidations.ValidateAll())
            {
                ToastService.ShowError("There are fields that are not valid.");
                return;
            }

            if (_sourceTransferWallet == null || _targetTransferWallet == null)
            {
                throw new ShowToUserException("There was an error while selecting the source or target wallet. Please, try again.");
            }

            // If hot wallet, we open the confirmation modal. Else we show an acknowledgement modal but
            // we create the withdrawal request anyways
            if (_sourceTransferWallet.IsHotWallet)
            {
                // Creation of request and clean up done in TransferFundsHotWallet method
                await _hotWalletTransferModal.ShowModal();
            }
            else
            {
                var amount = _selectedUTXOs.Count > 0 ? SelectedUTXOsValue() : _amountToTransfer;
                await CreateWithdrawalRequestForFunds(_sourceTransferWallet, _targetTransferWallet, amount,
    _transferAllFunds);
                await _multisigTransferModal.ShowModal();
                await CloseAndCleanTransferFundsModal();
            }
        }
        catch (ShowToUserException e)
        {
            ToastService.ShowError(e.Message);
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Error while transferring funds");
            ToastService.ShowError("There was an error while transferring funds, please contact a superadmin for troubleshooting.");
        }
    }

    private async Task TransferFundsHotWallet()
    {
        try
        {
            if (_sourceTransferWallet == null || _targetTransferWallet == null)
            {
                ToastService.ShowError("There was an error while selecting the source or target wallet. Please, try again.");
                return;
            }

            var amount = _selectedUTXOs.Count > 0 ? SelectedUTXOsValue() : _amountToTransfer;
            var withdrawalRequest = await CreateWithdrawalRequestForFunds(_sourceTransferWallet, _targetTransferWallet, amount,
    _transferAllFunds);
            var transferSuccess = await TransferInnerWithdrawalProcess(withdrawalRequest);

            if (transferSuccess)
            {
                ToastService.ShowSuccess("Funds transferred successfully");
                await AuditService.LogAsync(
                    AuditActionType.Transfer,
                    AuditEventType.Success,
                    AuditObjectType.Wallet,
                    _sourceTransferWallet?.Id.ToString(),
                    new
                    {
                        SourceWallet = _sourceWalletName,
                        TargetWallet = _targetWalletName,
                        Amount = _amountToTransfer,
                        AllFunds = _transferAllFunds,
                        WithdrawalRequestId = withdrawalRequest.Id
                    });
            }
            else
            {
                await AuditService.LogAsync(
                    AuditActionType.Transfer,
                    AuditEventType.Failure,
                    AuditObjectType.Wallet,
                    _sourceTransferWallet?.Id.ToString(),
                    new
                    {
                        SourceWallet = _sourceWalletName,
                        TargetWallet = _targetWalletName,
                        Amount = _amountToTransfer,
                        WithdrawalRequestId = withdrawalRequest.Id
                    });
                ToastService.ShowError("Error while transferring funds, please contact a superadmin for troubleshooting");
            }

            await CloseHotWalletTransferModal();
            await CloseAndCleanTransferFundsModal();
        }
        catch (ShowToUserException e)
        {
            ToastService.ShowError(e.Message);
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Error while transferring funds (hot wallet)");
            ToastService.ShowError("There was an error while transferring funds, please contact a superadmin for troubleshooting.");
        }
    }

    private async Task<bool> TransferInnerWithdrawalProcess(WalletWithdrawalRequest withdrawalRequest)
    {
        bool result = false;

        async Task CleanUpWithdrawalRequest(string errorMessage)
        {
            await CloseHotWalletTransferModal();
            ToastService.ShowError(errorMessage);
            withdrawalRequest.Status = WalletWithdrawalRequestStatus.Failed;
            var (success, err) = WalletWithdrawalRequestRepository.Update(withdrawalRequest);
            if (!success)
            {
                Logger.LogError("Error while updating the withdrawal request status to failed: {Error}", err);
            }
        }

        var walletWithdrawalRequestPsbt = new WalletWithdrawalRequestPSBT();

        try
        {
            var templatePSBT = await BitcoinService.GenerateTemplatePSBT(withdrawalRequest);
            walletWithdrawalRequestPsbt.WalletWithdrawalRequestId = withdrawalRequest.Id;
            walletWithdrawalRequestPsbt.PSBT = templatePSBT.ToBase64();
            walletWithdrawalRequestPsbt.SignerId = null;
        }
        catch (NoUTXOsAvailableException e)
        {
            Logger.LogError(e, "No UTXOs available for withdrawals were found for this wallet");
            await CleanUpWithdrawalRequest("No UTXOs available for withdrawals were found for this wallet");
            return result;
        }
        catch (ShowToUserException e)
        {
            await CleanUpWithdrawalRequest(e.Message);
            return result;
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Error while generating the PSBT for the withdrawal request");
            await CleanUpWithdrawalRequest("Something went wrong");
            return result;
        }

        var addResult = await WalletWithdrawalRequestPsbtRepository.AddAsync(walletWithdrawalRequestPsbt);

        if (!addResult.Item1)
        {
            throw new ShowToUserException("Error while saving the signature");
        }

        var req = await WalletWithdrawalRequestRepository.GetById(withdrawalRequest.Id);
        if (req == null)
        {
            throw new ShowToUserException("Error while retrieving the withdrawal request");
        }

        withdrawalRequest = req;

        if (withdrawalRequest.AreAllRequiredHumanSignaturesCollected)
        {
            var isWithdrawalProcessed = await CreateJobForFunds(withdrawalRequest);
            result = isWithdrawalProcessed;
        }
        else
        {
            throw new ShowToUserException("Invalid PSBT");
        }

        return result;
    }

    private async Task<bool> CreateJobForFunds(WalletWithdrawalRequest withdrawalRequest)
    {
        var result = false;

        try
        {
            IScheduler scheduler = await SchedulerFactory.GetScheduler();

            var map = new JobDataMap();
            map.Put("withdrawalRequestId", withdrawalRequest.Id);

            var job = SimpleJob.Create<PerformWithdrawalJob>(map, withdrawalRequest.Id.ToString());
            await scheduler.ScheduleJob(job.Job, job.Trigger);

            if (withdrawalRequest != null)
            {
                WalletWithdrawalRequestRepository.Update(withdrawalRequest);
                result = true;
            }
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Error while scheduling withdrawal job for request {RequestId}", withdrawalRequest.Id);
            withdrawalRequest.Status = WalletWithdrawalRequestStatus.Failed;
            WalletWithdrawalRequestRepository.Update(withdrawalRequest);
        }

        return result;
    }

    // Opens the modal and sets the source wallet if provided
    public async Task Show(Wallet? wallet = null)
    {
        _sourceTransferWallet = wallet;
        if (_sourceTransferWallet != null)
        {
            (_sourceWalletBalance, _) = await BitcoinService.GetWalletConfirmedBalance(_sourceTransferWallet);
        }

        var availableWallets = await WalletRepository.GetAvailableWallets(true);
        _walletsForTransfer = availableWallets.ToList();

        _sourceWalletSelectionDisabled = wallet != null;

        _selectedMempoolRecommendedFeesType = MempoolRecommendedFeesType.FastestFee;
        _customSatPerVbAmount = 1;

        await GetAvailableUTXOsForWallet(wallet);

        await _transferFundsModal.Show();
    }

    private async Task CloseAndCleanTransferFundsModal()
    {
        if (_transferFundsModal == null) return;
        await _transferFundsModal.Close(CloseReason.UserClosing);

        _walletsForTransfer.Clear();
        _sourceTransferWallet = null;
        _sourceWalletBalance = 0;
        _targetTransferWallet = null;
        _targetWalletBalance = 0;
        _amountToTransfer = _minWithdrawal;
        _transferAllFunds = false;
        _description = null;
        _selectedMempoolRecommendedFeesType = MempoolRecommendedFeesType.FastestFee;
        _customSatPerVbAmount = 1;
        ClearSelectedUTXOs();
    }

    private async Task OpenCoinSelectionModal()
    {
        if (_sourceTransferWallet == null)
        {
            ToastService.ShowError("Please select a source wallet first.");
            return;
        }

        await _utxoSelectorModalRef.ShowModal(_sourceTransferWallet.Id);
    }

    private void OnCloseCoinSelectionModal(List<UTXO> selectedUTXOs)
    {
        _selectedUTXOs = selectedUTXOs;
        if (_selectedUTXOs.Count > 0)
        {
            _amountToTransfer = SelectedUTXOsValue();
        }

        StateHasChanged();
    }

    private void ClearSelectedUTXOs()
    {
        _utxoSelectorModalRef.ClearModal();
        _selectedUTXOs.Clear();
        StateHasChanged();
    }

    private decimal SelectedUTXOsValue()
    {
        return _selectedUTXOs.Sum(x => ((Money)x.Value).ToUnit(MoneyUnit.BTC));
    }
}

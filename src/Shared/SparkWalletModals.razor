@using NodeGuard.Services.Spark
@using NSpark.Models
@inject ISparkWalletsService SparkWallets
@inject ISparkWalletService SparkWallet
@inject SparkSettings SparkSettings
@inject IWalletRepository WalletRepository
@inject INodeRepository NodeRepository
@inject IToastService ToastService
@inject ILogger<SparkWalletModals> Logger

@* Spark wallets (SPARK_SIGNER=wallet) on the Wallets page. Temporary: removed with the hot Spark wallets. *@

<Modal @ref="_createModal" Closing="OnCreateModalClosing">
    <ModalContent Centered Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>New Spark wallet</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            @if (_created is null)
            {
                <Alert Color="Color.Warning" Visible>
                    <AlertDescription>
                        A Spark wallet's keys are hot: its seed is stored encrypted in NodeGuard's database. Use it only to pass
                        swap-outs through, with a small max balance, and assign it to nodes in their liquidity settings.
                    </AlertDescription>
                </Alert>
                <Field>
                    <FieldLabel>Name</FieldLabel>
                    <TextEdit @bind-Text="_name" />
                </Field>
                <Field>
                    <FieldLabel>Spark account</FieldLabel>
                    <FieldHelp>The account its keys are derived at (m/8797555'/account'/…)</FieldHelp>
                    <NumericEdit TValue="int" @bind-Value="_account" Min="0" />
                </Field>
                <Field>
                    <FieldLabel>Max balance (sats)</FieldLabel>
                    <FieldHelp>The most it may hold, counting a new swap. Empty: SPARK_MAX_BALANCE_SATS (@SparkSettings.MaxBalanceSats.ToString("N0") sats)</FieldHelp>
                    <NumericEdit TValue="long?" @bind-Value="_maxBalanceSats" Min="1" />
                </Field>
            }
            else
            {
                <Alert Color="Color.Danger" Visible>
                    <AlertDescription>
                        Write these 24 words down now. They are shown only once, and they are the only way back to this wallet's
                        sats if NodeGuard's Data Protection key ring is lost.
                    </AlertDescription>
                </Alert>
                <p><strong>Identity:</strong> <code>@_created.Wallet.SparkIdentityPublicKey</code></p>
                <ol style="columns: 4">
                    @foreach (var word in _created.Mnemonic.Split(' '))
                    {
                        <li><code>@word</code></li>
                    }
                </ol>
                <Check TValue="bool" @bind-Checked="_backedUp">I've backed them up</Check>
            }
        </ModalBody>
        <ModalFooter>
            @if (_created is null)
            {
                <Button Color="Color.Secondary" Clicked="@(() => _createModal.Hide())">Cancel</Button>
                <Button Color="Color.Primary" Disabled="@(_busy || string.IsNullOrWhiteSpace(_name))" Clicked="CreateAsync">Create</Button>
            }
            else
            {
                <Button Color="Color.Primary" Disabled="@(!_backedUp)" Clicked="CloseCreatedAsync">Done</Button>
            }
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="_detailsModal">
    <ModalContent Centered Size="ModalSize.Large">
        <ModalHeader>
            <ModalTitle>Spark wallet @_wallet?.Name</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            @if (_wallet is not null)
            {
                var status = SparkWallet.GetStatus(new SparkWalletRef(_wallet.Id));
                <Table>
                    <TableBody>
                        <TableRow><TableRowHeader>Identity</TableRowHeader><TableRowCell><code>@_wallet.SparkIdentityPublicKey</code></TableRowCell></TableRow>
                        <TableRow><TableRowHeader>Account</TableRowHeader><TableRowCell>@(_wallet.SparkAccount ?? 0)</TableRowCell></TableRow>
                        <TableRow>
                            <TableRowHeader>Max balance</TableRowHeader>
                            <TableRowCell>
                                @SparkSettings.MaxBalanceFor(_wallet).ToString("N0") sats@(_wallet.SparkMaxBalanceSats is null ? " (SPARK_MAX_BALANCE_SATS)" : "")
                            </TableRowCell>
                        </TableRow>
                        <TableRow><TableRowHeader>Used by</TableRowHeader><TableRowCell>@(_usedBy.Count > 0 ? string.Join(", ", _usedBy) : "no node")</TableRowCell></TableRow>
                        <TableRow><TableRowHeader>Status</TableRowHeader><TableRowCell>@status.State @status.Reason</TableRowCell></TableRow>
                        @if (_loadingBalance)
                        {
                            <TableRow><TableRowHeader>Balance</TableRowHeader><TableRowCell>Reading the balance from the Spark operators…</TableRowCell></TableRow>
                        }
                        else if (_balanceError is not null)
                        {
                            <TableRow><TableRowHeader>Balance</TableRowHeader><TableRowCell><span class="text-danger">Not available: @_balanceError</span></TableRowCell></TableRow>
                        }
                        else if (_balance is not null)
                        {
                            <TableRow><TableRowHeader>Owned</TableRowHeader><TableRowCell>@_balance.Owned.ToString("N0") sats</TableRowCell></TableRow>
                            <TableRow><TableRowHeader>Available</TableRowHeader><TableRowCell>@_balance.Available.ToString("N0") sats</TableRowCell></TableRow>
                            <TableRow><TableRowHeader>Incoming</TableRowHeader><TableRowCell>@_balance.Incoming.ToString("N0") sats</TableRowCell></TableRow>
                            <TableRow><TableRowHeader>Frozen</TableRowHeader><TableRowCell>@_balance.Frozen.ToString("N0") sats</TableRowCell></TableRow>
                        }
                    </TableBody>
                </Table>
            }
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Disabled="_loadingBalance" Clicked="RefreshBalanceAsync">Refresh balance</Button>
            <Button Color="Color.Primary" Clicked="@(() => _detailsModal.Hide())">Close</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="_maxBalanceModal">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Max balance of @_wallet?.Name</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <Field>
                <FieldLabel>Max balance (sats)</FieldLabel>
                <FieldHelp>The most it may hold, counting a new swap. Empty: SPARK_MAX_BALANCE_SATS (@SparkSettings.MaxBalanceSats.ToString("N0") sats)</FieldHelp>
                <NumericEdit TValue="long?" @bind-Value="_maxBalanceSats" Min="1" />
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@(() => _maxBalanceModal.Hide())">Cancel</Button>
            <Button Color="Color.Primary" Disabled="_busy" Clicked="SaveMaxBalanceAsync">Save</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="_withdrawModal">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Withdraw all from @_wallet?.Name</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <p>
                Everything the Spark wallet holds exits on-chain, in one cooperative exit, to a new address of the wallet below.
                The SSP's fee is capped at @SparkSettings.MaxExitFeeSats.ToString("N0") sats (SPARK_MAX_EXIT_FEE_SATS).
            </p>
            <Field>
                <FieldLabel>Destination wallet</FieldLabel>
                <SelectList TItem="Wallet" TValue="int" Data="@_destinations" TextField="@(w => w.Name)" ValueField="@(w => w.Id)"
                            @bind-SelectedValue="_destinationWalletId" DefaultItemText="Choose the destination wallet" />
            </Field>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@(() => _withdrawModal.Hide())">Cancel</Button>
            <Button Color="Color.Primary" Disabled="@(_busy || _destinationWalletId == 0)" Clicked="WithdrawAllAsync">Withdraw all</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

<Modal @ref="_archiveModal">
    <ModalContent Centered>
        <ModalHeader>
            <ModalTitle>Archive @_wallet?.Name?</ModalTitle>
            <CloseButton />
        </ModalHeader>
        <ModalBody>
            <p>An archived Spark wallet can't be used for swaps. Only an empty wallet that no node uses can be archived.</p>
        </ModalBody>
        <ModalFooter>
            <Button Color="Color.Secondary" Clicked="@(() => _archiveModal.Hide())">Cancel</Button>
            <Button Color="Color.Danger" Disabled="_busy" Clicked="ArchiveAsync">Archive</Button>
        </ModalFooter>
    </ModalContent>
</Modal>

@code {
    /// <summary>Called after a Spark wallet was created, edited or archived</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private Modal _createModal = default!;
    private Modal _detailsModal = default!;
    private Modal _maxBalanceModal = default!;
    private Modal _withdrawModal = default!;
    private Modal _archiveModal = default!;

    private bool _busy;
    private string _name = string.Empty;
    private int _account;
    private long? _maxBalanceSats;
    private SparkWalletCreation? _created;
    private bool _backedUp;

    private Wallet? _wallet;
    private SatsBalance? _balance;
    private bool _loadingBalance;
    private string? _balanceError;
    private List<string> _usedBy = new();
    private List<Wallet> _destinations = new();
    private int _destinationWalletId;

    public async Task ShowCreateAsync()
    {
        _name = string.Empty;
        _account = 0;
        _maxBalanceSats = null;
        _created = null;
        _backedUp = false;
        await _createModal.Show();
    }

    public async Task ShowDetailsAsync(Wallet wallet)
    {
        _wallet = wallet;
        _balance = null;
        _usedBy = (await NodeRepository.GetAll()).Where(n => n.SparkWalletId == wallet.Id).Select(n => n.Name).ToList();
        await _detailsModal.Show();
        await RefreshBalanceAsync();
    }

    public async Task ShowMaxBalanceAsync(Wallet wallet)
    {
        _wallet = wallet;
        _maxBalanceSats = wallet.SparkMaxBalanceSats;
        await _maxBalanceModal.Show();
    }

    public async Task ShowWithdrawAllAsync(Wallet wallet)
    {
        _wallet = wallet;
        _destinationWalletId = 0;
        _destinations = await WalletRepository.GetAvailableWallets();
        await _withdrawModal.Show();
    }

    public async Task ShowArchiveAsync(Wallet wallet)
    {
        _wallet = wallet;
        await _archiveModal.Show();
    }

    private async Task CreateAsync()
    {
        await RunAsync(async () =>
        {
            _created = await SparkWallets.CreateAsync(_name, _account, _maxBalanceSats);
            ToastService.ShowSuccess($"Spark wallet {_created.Wallet.Name} created");
        });
    }

    private Task OnCreateModalClosing(ModalClosingEventArgs e)
    {
        // The words are shown once: the modal stays until they are confirmed backed up
        if (_created is not null && !_backedUp) e.Cancel = true;
        return Task.CompletedTask;
    }

    private async Task CloseCreatedAsync()
    {
        await _createModal.Hide();
        _created = null;
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Reads the wallet's current balance from the Spark operators. Re-renders itself: when the details open, this runs
    /// from the Wallets page's handler, which would only re-render the page
    /// </summary>
    private async Task RefreshBalanceAsync()
    {
        if (_wallet is null) return;

        _loadingBalance = true;
        _balanceError = null;
        StateHasChanged();
        try
        {
            _balance = await SparkWallets.GetBalanceAsync(_wallet.Id);
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException or SparkUnavailableException)
        {
            _balanceError = e.Message;
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Could not read the balance of Spark wallet {WalletId}", _wallet.Id);
            _balanceError = "the Spark operators could not be reached";
        }
        finally
        {
            _loadingBalance = false;
            StateHasChanged();
        }
    }

    private async Task SaveMaxBalanceAsync()
    {
        await RunAsync(async () =>
        {
            await SparkWallets.SetMaxBalanceAsync(_wallet!.Id, _maxBalanceSats);
            ToastService.ShowSuccess($"Max balance of {_wallet.Name} saved");
            await _maxBalanceModal.Hide();
            await OnChanged.InvokeAsync();
        });
    }

    private async Task WithdrawAllAsync()
    {
        await RunAsync(async () =>
        {
            var exit = await SparkWallets.WithdrawAllAsync(_wallet!.Id, _destinationWalletId);
            ToastService.ShowSuccess($"{_wallet.Name} withdrew {exit.PayoutSats:N0} sats in {exit.Txid} (SSP fee {exit.FeeSats:N0} sats)");
            await _withdrawModal.Hide();
        });
    }

    private async Task ArchiveAsync()
    {
        await RunAsync(async () =>
        {
            await SparkWallets.ArchiveAsync(_wallet!.Id);
            ToastService.ShowSuccess($"{_wallet.Name} archived");
            await _archiveModal.Hide();
            await OnChanged.InvokeAsync();
        });
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception e) when (e is InvalidOperationException or ArgumentException or SparkUnavailableException)
        {
            ToastService.ShowError(e.Message);
        }
        catch (Exception e)
        {
            Logger.LogError(e, "Spark wallet action failed");
            ToastService.ShowError("Something went wrong");
        }
        finally
        {
            // The modals are opened from the Wallets page, whose handlers re-render the page, not this component
            _busy = false;
            StateHasChanged();
        }
    }
}
